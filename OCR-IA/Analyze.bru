meta {
  name: Analyze
  type: http
  seq: 1
}

post {
  url: {{url}}/api/documents/analyze-with-fields
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/home/sebastien/Documents/Présentation-grilles-des-salaires.pdf)
  fields: '''
    [
      "salaires"
    ]
  ''' @contentType(application/json)
}

settings {
  encodeUrl: true
}
