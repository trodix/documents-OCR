meta {
  name: Analyze
  type: http
  seq: 1
}

post {
  url: {{url}}/api/documents/analyze-with-fields
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/media/DATA/workspace/DEV/CPAGE/ia-ocr/src/test/resources/ocr/carte-identite-france-format-bancaire.jpg)
  fields: '''
    [
      "nom",
      "prenom",
      "dateNaissance", 
      "dateExpiration",
      "numero"
    ]
  ''' @contentType(application/json)
}

settings {
  encodeUrl: true
}
