meta {
  name: analyze-with-fields
  type: http
  seq: 2
}

post {
  url: {{url}}/api/documents/analyze-with-fields
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  fields: [ "NomPoste"] @contentType(application/json)
